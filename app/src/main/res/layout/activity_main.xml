<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- 大標題 + 總開關 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/fg"
                android:textSize="34sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/serviceSwitch"
                style="@style/IosSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="總開關" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/compatNote"
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:text="@string/compat_note"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 權限卡片 -->
        <LinearLayout
            android:id="@+id/accessCard"
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/access_title"
                android:textColor="@color/fg"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/access_desc"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout style="@style/AccessRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_media"
                        android:textColor="@color/fg"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/mediaAccessState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/mediaAccessBtn"
                    style="@style/PillButton"
                    android:text="@string/access_open" />
            </LinearLayout>

            <LinearLayout style="@style/AccessRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_usage"
                        android:textColor="@color/fg"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/usageAccessState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/usageAccessBtn"
                    style="@style/PillButton"
                    android:text="@string/access_open" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/access_restricted"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 主卡片：目前裝置與音量 -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/deviceIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_headphones" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/deviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/fg"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deviceKind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/backToCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingStart="8dp"
                    android:text="@string/back_to_current"
                    android:textColor="@color/accentText"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/editingNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/editing_other"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 分段切換：目前的 App ／ 裝置預設 -->
            <LinearLayout
                android:id="@+id/targetRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="2dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/targetApp"
                    style="@style/SegmentButton" />

                <Button
                    android:id="@+id/targetDevice"
                    style="@style/SegmentButton"
                    android:layout_marginStart="2dp"
                    android:text="@string/device_default" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pct"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/fg"
                    android:textSize="56sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/db"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- 細滑桿 + 兩旁的 − / + -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/down"
                    style="@style/RoundStep"
                    android:contentDescription="降低音量"
                    android:text="−" />

                <SeekBar
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:paddingHorizontal="14dp"
                    android:progressDrawable="@drawable/seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb"
                    android:thumbOffset="0dp" />

                <Button
                    android:id="@+id/up"
                    style="@style/RoundStep"
                    android:contentDescription="加大音量"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/presets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 卡片下方說明：這個 App 的單獨音量 / 改回裝置預設 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/appNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/resetApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingStart="8dp"
                android:text="@string/reset_app"
                android:textColor="@color/accentText"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 測試音：一列 -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_tone" />

        <LinearLayout
            style="@style/Card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/pickMusic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_music" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pick_music"
                        android:textColor="@color/fg"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/toneFile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/toneButton"
                style="@style/PillButton"
                android:layout_marginStart="8dp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 這個裝置的設定 -->
        <TextView
            android:id="@+id/deviceSection"
            style="@style/SectionHeader" />

        <LinearLayout
            style="@style/Card"
            android:orientation="vertical">

            <Switch
                android:id="@+id/enabledSwitch"
                style="@style/RowSwitch"
                android:text="@string/enable_for_device" />

            <View style="@style/Hairline" />

            <Switch
                android:id="@+id/limiterSwitch"
                style="@style/RowSwitch"
                android:text="@string/limiter" />

            <View style="@style/Hairline" />

            <Switch
                android:id="@+id/sysVolSwitch"
                style="@style/RowSwitch"
                android:text="@string/remember_sys_volume" />
        </LinearLayout>

        <!-- 已記住的裝置 -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/saved_devices" />

        <LinearLayout
            android:id="@+id/deviceList"
            style="@style/Card"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
