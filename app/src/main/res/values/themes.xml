<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorControlHighlight">#14000000</item>
    </style>

    <!-- 白色圓角分組 -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_panel</item>
    </style>

    <!-- 分組上方的灰色小標題 -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- iOS 撥桿 -->
    <style name="IosSwitch">
        <item name="android:thumb">@drawable/sw_thumb</item>
        <item name="android:track">@drawable/sw_track</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:switchMinWidth">54dp</item>
        <item name="android:showText">false</item>
        <item name="android:background">@null</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="RowSwitch" parent="IosSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:switchPadding">12dp</item>
    </style>

    <style name="Hairline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/line</item>
    </style>

    <!-- 膠囊按鈕（播放、前往開啟） -->
    <style name="PillButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/accentInk</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SegmentButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_r7</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 滑桿兩旁的圓形 − / + -->
    <style name="RoundStep">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:textColor">@color/accentText</item>
        <item name="android:textSize">24sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="AccessRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
